# ==============================================================================
# Backend Environment Configuration Template (Production - Render / AWS)
# ==============================================================================

# Application Environment
APP_ENV=production

# Server Host and Port (Render/AWS App Runner provide PORT dynamically)
HOST=0.0.0.0
PORT=8000

# Database Connection URL (Provide your managed PostgreSQL database URL)
# Example Render Managed Database URL:
# DATABASE_URL=postgresql://caresync_user:secretpassword@dpg-xxxxxx.oregon-postgres.render.com/caresync
# Example AWS RDS PostgreSQL Database URL:
# DATABASE_URL=postgresql://dbadmin:secretpassword@caresync-db.xxxxxx.us-east-1.rds.amazonaws.com:5432/healthcare
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Allowed CORS Origins (specify frontend domains separated by comma)
# Example: https://caresync.onrender.com,https://healthcare.yourdomain.com
ALLOWED_ORIGINS=https://caresync.onrender.com
