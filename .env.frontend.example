# ==============================================================================
# Frontend Environment Configuration Template
# ==============================================================================
# Use these environment variables if deploying the frontend separately
# (e.g., AWS S3 + CloudFront, Render Static Site, Vercel, or Netlify).
#
# When using standard frameworks (React, Vite, Next.js), map to your framework prefix:
# - Vite: VITE_API_BASE_URL
# - Create React App: REACT_APP_API_BASE_URL
# - Next.js: NEXT_PUBLIC_API_BASE_URL
# ==============================================================================

# Backend API Endpoint URL
# If hosting frontend together with backend, relative '/api' is used automatically.
# If hosting frontend separately on a distinct domain / CDN:
API_BASE_URL=https://caresync-api.onrender.com/api

# Local Frontend Dev Server Port (if running separate node/vite/static server)
FRONTEND_PORT=3000

# Optional S3 / CloudFront Distribution Settings (for AWS deployment)
# S3_BUCKET_NAME=caresync-frontend-bucket
# CLOUDFRONT_DISTRIBUTION_ID=E123456789ABCD
